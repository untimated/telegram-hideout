# Configure these on the Hideout Cloud Run service. Keep real values out of Git.
TELEGRAM_BOT_TOKEN=
# One numeric group ID, or several separated by commas. Members of any may enter.
ALLOWED_GROUP_ID=
# TelegramBot service URL with /hideout/entered appended. Set both to enable.
HIDEOUT_NOTIFICATION_URL=
# Same random secret as HIDEOUT_NOTIFICATION_SECRET on TelegramBot.
HIDEOUT_NOTIFICATION_SECRET=
# Optional local/browser debug access. Leave both unset to disable guest login.
DEBUG_GUEST_USERNAME=
DEBUG_GUEST_PASSWORD=
